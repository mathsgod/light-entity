<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache/mysql"
         failOnDeprecation="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnSkipped="true"
         colors="true">
    <testsuites>
        <testsuite name="mysql-8-integration">
            <file>tests/integration/MySqlEntityExtensionsTest.php</file>
            <file>tests/integration/MySqlGlobalQueryFilterTest.php</file>
            <file>tests/integration/MySqlWhereRawTest.php</file>
            <file>tests/integration/MySqlValueConversionTest.php</file>
            <file>tests/integration/MySqlBulkWriteTest.php</file>
            <file>tests/integration/MySqlFetchClassTest.php</file>
            <file>tests/integration/MySqlFromSqlRawTest.php</file>
            <file>tests/integration/MySqlFunctionTest.php</file>
            <file>tests/integration/MySqlQueryTrackingTest.php</file>
            <file>tests/integration/MySqlChangeTrackerTest.php</file>
            <file>tests/integration/MySqlRelationshipTest.php</file>
            <file>tests/integration/MySqlJoinTest.php</file>
            <file>tests/integration/MySqlMigrationTest.php</file>
            <file>tests/integration/MySqlCompositeKeyTest.php</file>
            <file>tests/integration/MySqlInheritanceTest.php</file>
            <file>tests/integration/MySqlComplexPropertyTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
