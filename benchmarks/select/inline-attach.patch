@@ -149,0 +150,32 @@
+
+    public function testAttachmentCallbackRunsOnceForNativeAndSubsetMappings(): void
+    {
+        $pdo = $this->connection();
+        $pdo->exec('CREATE TABLE fetch_records (id INT PRIMARY KEY, active BOOLEAN)');
+        $pdo->exec('INSERT INTO fetch_records VALUES(1,1),(2,NULL)');
+        $db = new DbContext($pdo);
+        $set = $db->set(MySqlFetchRecord::class)->orderBy(Expr::field('id'));
+        $mapping = $db->model->getEntityType(MySqlFetchRecord::class);
+        $query = $set->asQueryable();
+        $provider = $query->provider();
+        $attached = [];
+        $rows = $provider->executeNoTrackingEntities($query->expression(), $mapping,
+            static function (Entity $entity) use (&$attached): void { $attached[] = $entity; });
+        self::assertCount(2, $attached);
+        self::assertSame($rows, $attached);
+        self::assertTrue($rows[0]->active);
+        self::assertNull($rows[1]->active);
+
+        // A partial explicit mapping uses associative hydration inside the provider.
+        // It must invoke the callback too, since DbContext no longer loops afterwards.
+        $subset = new \PhpEntity\EntityMapping(MySqlFetchRecord::class, 'fetch_records', ['id'],
+            generatedKey: false, columns: ['id' => $mapping->columns['id']]);
+        $attached = [];
+        $rows = $provider->executeNoTrackingEntities($query->expression(), $subset,
+            static function (Entity $entity) use (&$attached): void { $attached[] = $entity; });
+        self::assertCount(2, $attached);
+        self::assertSame($rows, $attached);
+        self::assertSame(1, $rows[0]->id);
+        self::assertSame(2, $rows[1]->id);
+        self::assertFalse($rows[0]->hasValue('active'));
+    }
