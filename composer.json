{
    "name": "mathsgod/light-entity",
    "description": "A PDO-based entity ORM built on php-linq",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "mathsgod/php-linq": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../light-linq"
        },
        {
            "type": "path",
            "url": "../light-collections",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Light\\Entity\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:mysql": "bash tests/integration/run-mysql.sh"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "mathsgod/light-collections": "@dev"
    },
    "autoload-dev": {
        "psr-4": {
            "Light\\Entity\\Tests\\": "tests/"
        }
    }
}
