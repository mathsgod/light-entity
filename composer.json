{
    "name": "mathsgod/light-entity",
    "description": "A PDO-based entity ORM built on light-linq",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "mathsgod/light-linq": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Light\\Entity\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:mysql": "bash tests/integration/run-mysql.sh"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "mathsgod/light-collections": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Light\\Entity\\Tests\\": "tests/"
        }
    }
}
